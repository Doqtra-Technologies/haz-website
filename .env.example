# Set CONTENT_SOURCE=sanity to serve content from Sanity (otherwise bundled content is used)
CONTENT_SOURCE=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token, used only by `pnpm seed:sanity`
SANITY_API_WRITE_TOKEN=
# Must match the secret set on the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=
